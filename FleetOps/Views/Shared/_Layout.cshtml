@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    IdentityUser? currentUser = null;
    IList<string> userRoles = new List<string>();
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null)
        {
            userRoles = await UserManager.GetRolesAsync(currentUser);
        }
    }
    var primaryRole = userRoles.FirstOrDefault() ?? "User";
    var initials = (currentUser?.Email ?? "?").Substring(0, 1).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark">
    <title>@ViewData["Title"] · FleetOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <header class="topbar">
            <div class="brand">
                <div class="logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 16V7a2 2 0 0 1 2-2h9v11"/>
                        <path d="M14 9h4l3 3v4h-7"/>
                        <circle cx="7.5" cy="17.5" r="2"/>
                        <circle cx="17.5" cy="17.5" r="2"/>
                    </svg>
                </div>
                FleetOps
            </div>
            <div class="who">
                <div class="meta">
                    <b>@currentUser?.Email</b>
                    <small>
                        <span class="chip @(primaryRole == "Administrator" ? "admin" : "")">@primaryRole</span>
                    </small>
                </div>
                <div class="avatar" title="@currentUser?.Email">@initials</div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ghost">Sign out</button>
                </form>
            </div>
        </header>
    }
    <main role="main">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>