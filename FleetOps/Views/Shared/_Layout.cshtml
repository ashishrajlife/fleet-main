@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    IdentityUser? currentUser = null;
    IList<string> userRoles = new List<string>();
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null)
            userRoles = await UserManager.GetRolesAsync(currentUser);
    }
    var primaryRole = userRoles.FirstOrDefault() ?? "User";
    var initials = (currentUser?.Email ?? "?").Substring(0, 1).ToUpperInvariant();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string c, string a) =>
        string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · FleetOps</title>
    <script>
      (function () {
        try {
          var t = localStorage.getItem('fleetops-theme');
          var theme = t === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap"> 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    <div class="app">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 16V7a2 2 0 0 1 2-2h9v11"/>
                        <path d="M14 9h4l3 3v4h-7"/>
                        <circle cx="7.5" cy="17.5" r="2"/>
                        <circle cx="17.5" cy="17.5" r="2"/>
                    </svg>
                </div>
                FleetOps
            </div>

            <nav class="nav-group">
                <span class="label">Overview</span>
                <a class="nav-item @(IsActive("Home","AdminDashboard") ? "active" : "")" asp-controller="Home" asp-action="AdminDashboard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    Dashboard
                </a>
            </nav>

            <nav class="nav-group">
                <span class="label">Fleet</span>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16V7a2 2 0 0 1 2-2h9v11"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
                    Vehicles
                </a>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>
                    Drivers
                </a>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="m7 6 5-4 5 4"/><path d="m7 18 5 4 5-4"/></svg>
                    Trips
                </a>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-12a7 7 0 1 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
                    Routes
                </a>
            </nav>

            <nav class="nav-group">
                <span class="label">Admin</span>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M14.5 20a5 5 0 0 1 7 0"/></svg>
                    Users
                </a>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
                    Roles
                </a>
                <a class="nav-item" href="#" onclick="return false;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h.1a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                    Settings
                </a>
            </nav>

            <div class="foot">© <span id="yr"></span> FleetOps</div>
        </aside>

        <div class="scrim" onclick="document.body.classList.remove('nav-open')"></div>

        <div class="main">
            <header class="topbar">
                <button class="menu-btn" type="button" aria-label="Open menu" onclick="document.body.classList.toggle('nav-open')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" placeholder="Search vehicles, drivers, trips…" aria-label="Search" />
                </div>
                <div class="who">
                    <div class="meta">
                        <b>@currentUser?.Email</b>
                        <small><span class="chip @(primaryRole == "Administrator" ? "admin" : "")">@primaryRole</span></small>
                    </div>
                    <button class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme" data-theme-toggle>
                        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                    <div class="avatar" title="@currentUser?.Email">@initials</div>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost">Sign out</button>
                    </form>
                </div>
            </header>

            <main role="main" class="content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}
<script>
    document.getElementById('yr') && (document.getElementById('yr').textContent = new Date().getFullYear());

    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var html = document.documentElement;
            var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', next);
            try { localStorage.setItem('fleetops-theme', next); } catch (e) {}
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>