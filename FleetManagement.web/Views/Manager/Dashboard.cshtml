@{
    ViewData["Title"] = "Manager Dashboard";
}

<div style="font-family: sans-serif; padding: 30px; max-width: 700px; margin: 0 auto;">
    <h1>Manager Dashboard</h1>
    <p>Welcome, <strong>@User.Identity?.Name</strong></p>

    <div style="display: flex; gap: 20px; margin-top: 30px;">
        <a href="/Manager/CreateUser"
           style="padding: 20px 30px; background: #2563eb; color: white; text-decoration: none; border-radius: 6px;">
            ➕ Create Driver / Viewer
        </a>

        <a href="/Manager/UserList"
           style="padding: 20px 30px; background: #16a34a; color: white; text-decoration: none; border-radius: 6px;">
            👥 Manage Drivers & Viewers
        </a>
    </div>

    <div style="margin-top: 40px;">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" style="padding: 10px 20px; cursor: pointer;">Logout</button>
        </form>
    </div>
</div>