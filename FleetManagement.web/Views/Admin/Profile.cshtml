@model FleetManagement.Web.Models.UserResponse
@{
    ViewData["Title"] = "My Profile";
}

<div style="font-family: sans-serif; padding: 30px; max-width: 500px; margin: 0 auto;">
    <h1>My Profile</h1>
    <p><a href="/Admin/Dashboard">← Dashboard</a></p>

    @if (TempData["Success"] != null)
    {
        <div style="background:#dcfce7; color:#166534; padding:10px; border-radius:4px; margin:15px 0;">
            @TempData["Success"]
        </div>
    }

    <table style="width:100%; border-collapse: collapse; margin-top: 20px;">
        <tr><td style="padding:6px 0;"><strong>Name</strong></td><td>@Model.Name</td></tr>
        <tr><td style="padding:6px 0;"><strong>Email</strong></td><td>@Model.Email</td></tr>
        <tr><td style="padding:6px 0;"><strong>Phone</strong></td><td>@Model.Phone</td></tr>
        <tr><td style="padding:6px 0;"><strong>Role</strong></td><td>@string.Join(", ", Model.Roles)</td></tr>
        <tr><td style="padding:6px 0;"><strong>Last Login</strong></td><td>@(Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td></tr>
    </table>

    <div style="margin-top: 20px;">
        <a href="/Admin/EditProfile"
           style="padding: 10px 20px; background:#2563eb; color:white; text-decoration:none; border-radius:4px;">
            ✏️ Edit Profile
        </a>
    </div>
</div>