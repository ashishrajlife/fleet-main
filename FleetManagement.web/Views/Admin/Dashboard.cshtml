@{
    ViewData["Title"] = "Admin Dashboard";
    var userName = User.Identity?.Name;
    var initial = string.IsNullOrEmpty(userName) ? "A" : userName.Substring(0, 1).ToUpper();
}

<section class="dash-hero">
    <div class="dash-hero__who">
        <div class="avatar" aria-hidden="true">@initial</div>
        <div>
            <h1 class="dash-title">Admin Dashboard</h1>
            <p class="dash-welcome">Welcome, <strong>@User.Identity?.Name</strong></p>
        </div>
    </div>

    <form class="dash-logout" asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-logout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            Logout
        </button>
    </form>
</section>

<h2 class="section-title">What would you like to do?</h2>

<div class="action-grid">
    <a href="/Admin/CreateUser" class="action-card action-card--primary">
        <span class="action-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        </span>
        <span class="action-card__body">
            <h3 class="action-card__title">Create User</h3>
            <p class="action-card__text">Add a new user account.</p>
        </span>
        <span class="action-card__go">
            Create user
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
    </a>

    <a href="/Admin/UserList" class="action-card">
        <span class="action-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <span class="action-card__body">
            <h3 class="action-card__title">View All Users</h3>
            <p class="action-card__text">See every user account in the system.</p>
        </span>
        <span class="action-card__go">
            Open list
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
    </a>
</div>
