@model FleetManagement.Web.Models.CreateUserRequest
@{
    ViewData["Title"] = "Create User";
}

<div class="form-wrap">
    <a href="/Admin/Dashboard" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        Back to Dashboard
    </a>

    <h1 class="page-head__title mb-3">Create New User</h1>

    <div class="form-card" style="max-width:none;">
        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()

            <div class="field">
                <label asp-for="Name">Full Name</label>
                <input asp-for="Name" class="input" autocomplete="name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="input" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Phone">Phone</label>
                <input asp-for="Phone" class="input" inputmode="tel" autocomplete="tel" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="input" autocomplete="new-password" />
                <span class="field-hint">Min 8 chars, at least 1 upper, 1 digit</span>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Role">Role</label>
                <select asp-for="Role" class="input">
                    <option value="driver">Driver</option>
                    <option value="manager">Manager</option>
                    <option value="viewer">Viewer</option>
                    <option value="admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="field-error"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-box alert-box--err" role="alert">
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn-signal">Create User</button>
            </div>
        </form>
    </div>
</div>
