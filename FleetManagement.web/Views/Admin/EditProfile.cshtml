@model FleetManagement.Web.Models.UpdateProfileRequest
@{
    ViewData["Title"] = "Edit Profile";
}

<div style="font-family: sans-serif; padding: 30px; max-width: 500px; margin: 0 auto;">
    <h1>Edit My Profile</h1>
    <p><a href="/Admin/Profile">← Back to profile</a></p>

    <form asp-action="EditProfile" method="post" style="margin-top: 20px;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div style="margin-bottom: 15px;">
            <label>Name</label>
            <input asp-for="Name" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;" />
            <span asp-validation-for="Name" style="color:red; font-size:12px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Phone</label>
            <input asp-for="Phone" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;" />
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="color:red; margin-bottom: 15px;">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <button type="submit"
                style="padding: 10px 20px; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">
            Save
        </button>
    </form>
</div>