@model List<FleetManagement.Web.Models.UserResponse>
@{
    ViewData["Title"] = "All Users";
    var currentEmail = User.Identity?.Name ?? "";
}

<a href="/Admin/Dashboard" class="back-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
    Dashboard
</a>

<div class="page-head">
    <h1 class="page-head__title">All Users</h1>
    <a href="/Admin/CreateUser" class="btn-signal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Create User
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-box alert-box--ok" role="status">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-box alert-box--err" role="alert">
        @TempData["Error"]
    </div>
}

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Last Login</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                var isSelf = u.Email == currentEmail;
                var initial = string.IsNullOrEmpty(u.Name) ? "?" : u.Name.Substring(0, 1).ToUpper();
                <tr class="@(u.IsActive ? "" : "is-inactive")">
                    <td class="cell-name">
                        <div class="person">
                            <span class="person__avatar" aria-hidden="true">@initial</span>
                            <span>@u.Name @if (isSelf) { <span class="you-tag">you</span> }</span>
                        </div>
                    </td>
                    <td data-label="Email">@u.Email</td>
                    <td data-label="Phone">@u.Phone</td>
                    <td data-label="Roles">
                        <span>
                            @foreach (var r in u.Roles)
                            {
                                <span class="pill">@r</span>
                            }
                        </span>
                    </td>
                    <td data-label="Status">
                        @if (u.IsActive)
                        {
                            <span class="status status--on">Active</span>
                        }
                        else
                        {
                            <span class="status status--off">Inactive</span>
                        }
                    </td>
                    <td data-label="Last Login" class="muted">
                        @(u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                    </td>
                    <td class="cell-actions">
                        @if (isSelf)
                        {
                            <span class="muted">—</span>
                        }
                        else
                        {
                            <a href="/Admin/EditUser/@u.Id" class="row-action row-action--edit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                Edit
                            </a>

                            <a href="/Admin/ResetPassword/@u.Id" class="row-action row-action--reset">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3 21 2M16 7l3 3"/></svg>
                                Reset Pwd
                            </a>

                            <form method="post" asp-action="ToggleActive">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="row-action @(u.IsActive ? "row-action--off" : "row-action--on")">
                                    @if (u.IsActive)
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                                        <text>Deactivate</text>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7Z"/></svg>
                                        <text>Activate</text>
                                    }
                                </button>
                            </form>

                            <form method="post" asp-action="DeleteUser"
                                  onsubmit="return confirm('Delete @u.Name permanently? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="row-action row-action--del">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                                    Delete
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
